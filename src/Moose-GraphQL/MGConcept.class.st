"
I describe one GraphQL type generated by MGModelSchemaBuilder for a specific Moose model.

I wrap an FM3 type of the model metamodel (#fm3Type) and am of one of two kinds (#kind):
- an object concept (#isObject, alias #isRoot; created with #objectType:conformingClasses:): a concrete class having instances in the model, exposed as a GraphQL OBJECT type;
- an interface concept (#isInterface, alias #isHelper; created with #interfaceType:conformingClasses:): an FM3 supertype (superclass or trait) of such classes, exposed as a GraphQL INTERFACE type.
Both kinds get root list / by-id fields on the Query type (#listFieldName and #byIdFieldName).

#conformingClasses are the concrete FM3 classes of the model (having instances) conforming to my FM3 type: my root list field answers their instances, and my by-id root field only accepts entities of these classes (only my own class for an object concept).

#interfaces are the interface concepts my type implements (the full transitive list), #interfaceNames the GraphQL interface names (MooseEntity first). #fields are my specific field specs (MGConceptField, by field name). #typeName is my GraphQL type name.
"
Class {
	#name : 'MGConcept',
	#superclass : 'Object',
	#instVars : [
		'fm3Type',
		'conformingClasses',
		'typeName',
		'listFieldName',
		'byIdFieldName',
		'fields',
		'interfaces',
		'kind'
	],
	#category : 'Moose-GraphQL-Schema',
	#package : 'Moose-GraphQL',
	#tag : 'Schema'
}

{ #category : 'instance creation' }
MGConcept class >> helperType: anFM3Type conformingClasses: aCollection [
	"Alias of #interfaceType:conformingClasses:"

	^ self interfaceType: anFM3Type conformingClasses: aCollection
]

{ #category : 'instance creation' }
MGConcept class >> interfaceType: anFM3Type conformingClasses: aCollection [
	"An interface concept: anFM3Type is a supertype (superclass or trait) of the concrete classes aCollection having instances in the model, exposed as a GraphQL interface type"

	^ self new
		  setType: anFM3Type
		  conformingClasses: aCollection
		  kind: #interface
]

{ #category : 'instance creation' }
MGConcept class >> objectType: anFM3Class conformingClasses: aCollection [
	"An object concept: anFM3Class is a concrete class having instances in the model, exposed as a GraphQL object type"

	^ self new
		  setType: anFM3Class
		  conformingClasses: aCollection
		  kind: #object
]

{ #category : 'instance creation' }
MGConcept class >> rootType: anFM3Class conformingClasses: aCollection [
	"Alias of #objectType:conformingClasses:"

	^ self objectType: anFM3Class conformingClasses: aCollection
]

{ #category : 'accessing' }
MGConcept >> byIdFieldName [
	^ byIdFieldName
]

{ #category : 'accessing' }
MGConcept >> byIdFieldName: aString [
	byIdFieldName := aString
]

{ #category : 'accessing' }
MGConcept >> comment [
	"FM3 comment of my type, or an empty String"
	^ MGSafe do: [ fm3Type comment ifNil: [ '' ] ifNotNil: [ :c | c asString trimBoth ] ] default: ''
]

{ #category : 'accessing' }
MGConcept >> conformingClasses [
	"Concrete FM3 classes of the model conforming to my FM3 type"
	^ conformingClasses
]

{ #category : 'accessing' }
MGConcept >> description [
	"Description of my GraphQL type"

	^ String streamContents: [ :s |
		  s
			  nextPutAll: 'Moose concept ';
			  nextPutAll: self fullName.
		  self isInterface ifTrue: [ self printInterfaceNoteOn: s ].
		  s nextPut: $..
		  self comment ifNotEmpty: [ :c |
			  s
				  space;
				  nextPutAll: c ] ]
]

{ #category : 'accessing' }
MGConcept >> fields [
	"Field specs of the concept type (see MGModelSchemaBuilder>>#fieldSpecsOf:), by field name"

	^ fields ifNil: [ fields := OrderedDictionary new ]
]

{ #category : 'accessing' }
MGConcept >> fields: anOrderedDictionary [
	fields := anOrderedDictionary
]

{ #category : 'accessing' }
MGConcept >> fm3Type [
	^ fm3Type
]

{ #category : 'accessing' }
MGConcept >> fullName [
	"FM3 qualified name (e.g. Famix-Test1-Entities.Method)"
	^ MGSafe do: [ fm3Type fullName asString ] default: [ self shortName ]
]

{ #category : 'accessing' }
MGConcept >> interfaceNames [
	"Names of the GraphQL interfaces implemented by my type: MooseEntity first, then my supertype interfaces"

	^ (Array with: 'MooseEntity')
	  , (self interfaces collect: [ :each | each typeName ]) asArray
]

{ #category : 'accessing' }
MGConcept >> interfaces [
	"Interface concepts implemented by the concept type"

	^ interfaces ifNil: [ interfaces := OrderedCollection new ]
]

{ #category : 'accessing' }
MGConcept >> interfaces: aCollection [
	interfaces := aCollection
]

{ #category : 'testing' }
MGConcept >> isHelper [
	"Alias of #isInterface"

	^ self isInterface
]

{ #category : 'testing' }
MGConcept >> isInterface [
	"True when I stand for a supertype (superclass or trait) of concrete classes having instances in the model, exposed as a GraphQL interface type"

	^ kind = #interface
]

{ #category : 'testing' }
MGConcept >> isObject [
	"True when I stand for a concrete class having instances in the model, exposed as a GraphQL object type"

	^ kind = #object
]

{ #category : 'testing' }
MGConcept >> isRoot [
	"Alias of #isObject"

	^ self isObject
]

{ #category : 'accessing' }
MGConcept >> kind [
	"#object or #interface"

	^ kind
]

{ #category : 'accessing' }
MGConcept >> listFieldName [
	^ listFieldName
]

{ #category : 'accessing' }
MGConcept >> listFieldName: aString [
	listFieldName := aString
]

{ #category : 'printing' }
MGConcept >> printInterfaceNoteOn: aStream [
	"Explain on aStream that I am an interface, listing my conforming concrete classes"

	aStream nextPutAll: ' (interface implemented by the entities of: '.
	conformingClasses
		do: [ :each |
			aStream nextPutAll:
				(MGSafe do: [ each name asString ] default: '?') ]
		separatedBy: [ aStream nextPutAll: ', ' ].
	aStream nextPut: $)
]

{ #category : 'printing' }
MGConcept >> printOn: aStream [
	super printOn: aStream.
	aStream
		nextPut: $(;
		nextPutAll: (typeName ifNil: [ self fullName ]);
		nextPut: $)
]

{ #category : 'initialization' }
MGConcept >> setType: anFM3Type conformingClasses: aCollection kind: aSymbol [

	fm3Type := anFM3Type.
	conformingClasses := aCollection asArray.
	kind := aSymbol
]

{ #category : 'accessing' }
MGConcept >> shortName [
	"FM3 short name (e.g. Method)"
	^ MGSafe do: [ fm3Type name asString ] default: ''
]

{ #category : 'accessing' }
MGConcept >> typeName [
	^ typeName
]

{ #category : 'accessing' }
MGConcept >> typeName: aString [
	typeName := aString
]
