"
I describe one GraphQL object type generated by MGModelSchemaBuilder for a specific Moose model.

I wrap an FM3 type of the model metamodel (#fm3Type) and am one of two kinds:
- a root concept (#isRoot, created with #rootType:conformingClasses:): a concrete class having instances in the model. Only root concepts get root fields on the Query type (#listFieldName and #byIdFieldName), so only they are listed as the concepts of the model;
- a hidden helper concept (#isHelper, created with #helperType:conformingClasses:): the declared trait / abstract type of a relation satisfied by two or more concrete classes of the model (e.g. TWithComments -> Class, Method). I keep such a polymorphic relation navigable but have no root field.

#conformingClasses are the concrete FM3 classes of the model (having instances) that conform to my FM3 type: my root list field answers their instances, and my by-id root field only accepts entities of these classes.

#typeName is my GraphQL object type name.
"
Class {
	#name : 'MGConcept',
	#superclass : 'Object',
	#instVars : [
		'fm3Type',
		'conformingClasses',
		'typeName',
		'listFieldName',
		'byIdFieldName',
		'isRoot'
	],
	#category : 'Moose-GraphQL-Schema',
	#package : 'Moose-GraphQL',
	#tag : 'Schema'
}

{ #category : 'instance creation' }
MGConcept class >> helperType: anFM3Type conformingClasses: aCollection [
	"A hidden helper concept: anFM3Type is the declared trait / abstract type of a relation satisfied by several concrete classes of the model; reachable through relations only, without root fields"

	^ self new
		  setType: anFM3Type
		  conformingClasses: aCollection
		  root: false
]

{ #category : 'instance creation' }
MGConcept class >> rootType: anFM3Class conformingClasses: aCollection [
	"A root concept: anFM3Class is a concrete class having instances in the model, exposed with root fields on Query"

	^ self new
		  setType: anFM3Class
		  conformingClasses: aCollection
		  root: true
]

{ #category : 'accessing' }
MGConcept >> byIdFieldName [
	^ byIdFieldName
]

{ #category : 'accessing' }
MGConcept >> byIdFieldName: aString [
	byIdFieldName := aString
]

{ #category : 'accessing' }
MGConcept >> comment [
	"FM3 comment of my type, or an empty String"
	^ MGSafe do: [ fm3Type comment ifNil: [ '' ] ifNotNil: [ :c | c asString trimBoth ] ] default: ''
]

{ #category : 'accessing' }
MGConcept >> conformingClasses [
	"Concrete FM3 classes of the model conforming to my FM3 type"
	^ conformingClasses
]

{ #category : 'accessing' }
MGConcept >> description [
	"Description of my GraphQL object type"

	^ String streamContents: [ :s |
			  s
				  nextPutAll: 'Moose concept ';
				  nextPutAll: self fullName.
			  self isHelper ifTrue: [ self printHelperNoteOn: s ].
			  s nextPut: $..
			  self comment ifNotEmpty: [ :c |
					  s
						  space;
						  nextPutAll: c ] ]
]

{ #category : 'accessing' }
MGConcept >> fm3Type [
	^ fm3Type
]

{ #category : 'accessing' }
MGConcept >> fullName [
	"FM3 qualified name (e.g. Famix-Test1-Entities.Method)"
	^ MGSafe do: [ fm3Type fullName asString ] default: [ self shortName ]
]

{ #category : 'testing' }
MGConcept >> isHelper [
	"True when I am a hidden helper type: the declared trait / abstract type of a polymorphic relation, reachable through relations only"

	^ self isRoot not
]

{ #category : 'testing' }
MGConcept >> isRoot [
	"True when I stand for a concrete class having instances in the model: I then get root list / by-id fields on Query"

	^ isRoot == true
]

{ #category : 'accessing' }
MGConcept >> listFieldName [
	^ listFieldName
]

{ #category : 'accessing' }
MGConcept >> listFieldName: aString [
	listFieldName := aString
]

{ #category : 'printing' }
MGConcept >> printHelperNoteOn: aStream [
	"Explain on aStream that I am a polymorphic relation target, listing my conforming concrete classes"

	aStream nextPutAll:
		' (polymorphic relation target, reachable through relations only: any entity whose type conforms to it, i.e. '.
	conformingClasses
		do: [ :each |
			aStream nextPutAll:
				(MGSafe do: [ each name asString ] default: '?') ]
		separatedBy: [ aStream nextPutAll: ', ' ].
	aStream nextPut: $)
]

{ #category : 'printing' }
MGConcept >> printOn: aStream [
	super printOn: aStream.
	aStream
		nextPut: $(;
		nextPutAll: (typeName ifNil: [ self fullName ]);
		nextPut: $)
]

{ #category : 'initialization' }
MGConcept >> setType: anFM3Type conformingClasses: aCollection root: aBoolean [

	fm3Type := anFM3Type.
	conformingClasses := aCollection asArray.
	isRoot := aBoolean
]

{ #category : 'accessing' }
MGConcept >> shortName [
	"FM3 short name (e.g. Method)"
	^ MGSafe do: [ fm3Type name asString ] default: ''
]

{ #category : 'accessing' }
MGConcept >> typeName [
	^ typeName
]

{ #category : 'accessing' }
MGConcept >> typeName: aString [
	typeName := aString
]
